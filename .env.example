# =============================================================================
# ENVIRONMENT CONFIGURATION FILE (.env.example)
# =============================================================================
# Copy this file to `.env` and edit the values for your environment.
# NEVER commit `.env` to version control.
# When adding a new env() reference in code, update BOTH this file and .env.
# =============================================================================

# =============================================================================
# APPLICATION CORE
# =============================================================================

# APP_KEY — Encryption key for cookies, sessions, and passwords. Auto-generated
# by 'php artisan key:generate'. If lost, all encrypted data becomes unreadable.
APP_KEY=

# APP_NAME — Shown in page titles, emails, and browser tabs. Quoted to allow spaces.
APP_NAME="Your Application Name"

# APP_ENV — Controls error display and config caching behavior.
# 'local' shows detailed errors; 'production' hides them. Always use 'production' on live servers.
APP_ENV=local

# APP_DEBUG — When true, full stack traces are shown on errors (security risk in production).
# MUST be false in production to prevent leaking server internals to users.
APP_DEBUG=true

# APP_URL — The base URL of the application. Used for generating links in emails,
# console commands, and asset URLs. Must match your actual domain including protocol (http/https).
APP_URL=http://localhost

# APP_TIMEZONE — Server timezone for date/time operations. All timestamps in the app
# (logs, created_at, scheduled tasks) use this timezone.
APP_TIMEZONE=Asia/Kolkata

# ASSET_URL — Base URL for loading CSS, JS, and images. Only set if you serve static
# assets from a CDN or different domain. Leave commented out to use APP_URL.
#ASSET_URL=http://localhost

# PRODUCTION_DOMAIN_URL — The production domain name (without protocol). Used by
# AppServiceProvider to detect production environment and switch to the production database.
PRODUCTION_DOMAIN_URL="your-production-domain.com"

# COMPANY_NAME — Displayed in the sidebar, headers, PDF exports, and email templates.
COMPANY_NAME="Your Company Name"

# COMPANY_ADDRESS — Displayed on invoices, purchase orders, and other printed documents.
COMPANY_ADDRESS="Your Company Address"

# =============================================================================
# LOCALIZATION
# =============================================================================

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =============================================================================
# DATABASE
# =============================================================================
# The app supports dual databases: a primary (remote/production) and a local (development).
# AppServiceProvider switches between them based on USE_LOCAL_DB or the request domain.

# USE_LOCAL_DB — When true, all queries go to the DB_*_LOCAL connection (for local dev).
# When false, queries go to the primary DB_* connection (production/staging).
USE_LOCAL_DB=true

# --- Primary Database Connection (Production/Staging) ---
# Default: MySQL / MariaDB
DB_CONNECTION=mysql
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT=true
MYSQL_ATTR_SSL_CA=

# --- PostgreSQL (e.g. Render) ---
# Uncomment and set DB_CONNECTION=pgsql to use PostgreSQL instead of MySQL/MariaDB.
# The AppServiceProvider will automatically use the pgsql connection when
# DB_CONNECTION is set to 'pgsql'.
# DB_CONNECTION=pgsql
# DB_HOST=your-pg-host
# DB_PORT=5432
# DB_DATABASE=your_pg_database
# DB_USERNAME=your_pg_user
# DB_PASSWORD=your_pg_password
# DB_SSLMODE=require

# --- Secondary/Local Database Connection (Development) ---
DB_CONNECTION_LOCAL=mysql
DB_DRIVER_LOCAL=mariadb
DB_HOST_LOCAL=127.0.0.1
DB_PORT_LOCAL=3306
DB_DATABASE_LOCAL=your_local_database_name
DB_USERNAME_LOCAL=your_local_database_user
DB_PASSWORD_LOCAL=your_local_database_password
DB_CHARSET_LOCAL=utf8mb4
DB_COLLATION_LOCAL=utf8mb4_unicode_ci
DB_STRICT_LOCAL=true

# =============================================================================
# MAIL & EMAIL
# =============================================================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=rppatel5257@gmail.com
MAIL_USERNAME=rppatel5257@gmail.com
MAIL_PASSWORD="qtyi zrdw eeoi ijyo"
MAIL_FROM_NAME="${APP_NAME}"

# CUSTOM_EMAIL_FROM / CUSTOM_EMAIL_FROM_NAME — Override MAIL_FROM_ADDRESS / MAIL_FROM_NAME
# for business emails sent by the app (separate from system notifications).
CUSTOM_EMAIL_FROM=
CUSTOM_EMAIL_FROM_NAME=

# =============================================================================
# CACHING, SESSION, QUEUE
# =============================================================================

# SESSION_DRIVER — Where user sessions are stored.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# BROADCAST / CACHE / FILESYSTEM / QUEUE
BROADCAST_DRIVER=log
CACHE_STORE=database
CACHE_PREFIX=app_cache
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# =============================================================================
# REDIS (optional)
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# =============================================================================
# MEMCACHED (optional)
# =============================================================================
MEMCACHED_HOST=127.0.0.1

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# LOG_MODULE_RETENTION_DAYS — Retention for per-module daily channels auto-registered
# by App\Logging\ModuleChannelRegistrar. Each module slug under Modules/ gets its own
# rotating channel at storage/logs/<slug>/<slug>-{date}.log.
LOG_MODULE_RETENTION_DAYS=90
#LOG_MODULE_LEVEL=

# Laravel Boost MCP server integration
BOOST_BROWSER_LOGS_WATCHER=false
BOOST_ENABLED=true

# =============================================================================
# SECURITY & PERFORMANCE
# =============================================================================

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# =============================================================================
# CLOUD SERVICES (optional)
# =============================================================================

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Pusher ---
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# =============================================================================
# FRONTEND BUILD (Vite)
# =============================================================================

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# =============================================================================
# USER INTERFACE & NAVIGATION
# =============================================================================

# NAVIGATION_MENU_THEME — Default menu layout for new users. 'vertical' shows a left sidebar;
# 'horizontal' shows a top navigation bar. Users can switch in the header after login.
NAVIGATION_MENU_THEME=vertical

# ENABLE_MULTI_SESSION_LOGOUT — When 1, logging in from a new device/browser automatically
# logs out all other active sessions. Prevents multiple people using the same account.
ENABLE_MULTI_SESSION_LOGOUT=1

# =============================================================================
# LOGO BACKGROUND
# =============================================================================
# Controls the background color behind the logo in each layout placement.
# Accepts any CSS color: hex (#ffffff), rgb(), rgba(), or 'transparent'.
# Hex values MUST be quoted — a bare leading '#' is parsed as a comment and resolves to empty.

LOGO_BG_LOGIN_HERO="#ffffff"
LOGO_BG_LOGIN_CARD=transparent
LOGO_BG_HORIZONTAL=transparent
LOGO_BG_SIDEBAR=transparent
LOGO_BG_SIDEBAR_SM=transparent
LOGO_BG_MOBILE=transparent
LOGO_BG_HORIZONTAL_DARK="#ffffff"
LOGO_BG_SIDEBAR_DARK="#ffffff"
LOGO_BG_SIDEBAR_SM_DARK="#ffffff"
LOGO_BG_MOBILE_DARK="#ffffff"
LOGO_BG_LOGIN_CARD_DARK=transparent

# Install-type profile cascade.
# The boilerplate ships with one profile ('default'). To add more, declare them
# in config/profiles.php and set INSTALL_TYPE=<name>.
# `php artisan business:status` shows the resolved value of every flag.
INSTALL_TYPE=default

# SYSTEM_DATE_FORMAT — Default date format used across the system for display.
SYSTEM_DATE_FORMAT="d-m-Y h:i:s"

# MIN_COMMENT_LENGTH / MAX_COMMENT_LENGTH — Character limits for the remarks-field
# partial. Ensures meaningful audit trail entries (not too short, not too long).
MIN_COMMENT_LENGTH=3
MAX_COMMENT_LENGTH=1000

# YEAR_DISPLAY_FORMAT — How financial years are shown in the year selector dropdown.
# full_short: 2023-24 | short_full: 23-2024 | short_short: 23-24
# full_full: 2023-2024 | short: 24 | full: 2024
YEAR_DISPLAY_FORMAT=full_short

# FY_START_MONTH — The month your fiscal year begins. 4 = April (Indian FY).
# 1 = January (calendar year). Affects year dropdown and report periods.
FY_START_MONTH=4

# =============================================================================
# THEME MIGRATION (Development Aid)
# =============================================================================

# SHOW_CONVERTED_MODULES — When 1, shows a checkmark beside sidebar menu items
# whose module has been converted to the Tailwind theme.
SHOW_CONVERTED_MODULES=0

# =============================================================================
# DATATABLES
# =============================================================================

# DATATABLES_ERROR — How DataTable server-side processing errors are handled.
# 'throw' shows the error (dev), 'alert' shows a popup, 'log' writes to log silently.
DATATABLES_ERROR=throw

# =============================================================================
# MODULE SYSTEM
# =============================================================================

# MODULE_VENDOR — The vendor namespace used when generating new modules.
MODULE_VENDOR=nwidart

# INSTALLER_DISABLE_AUTO_DETECT — when true, EnsureInstalled middleware skips
# the legacy-install auto-mark heuristic.
INSTALLER_DISABLE_AUTO_DETECT=false

# =============================================================================
# API AUTHENTICATION (Sanctum)
# =============================================================================

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# =============================================================================
# SCHEMA VALIDATION SYSTEM
# =============================================================================
# Controls the FormRequest → JSON-rule cache used for client-side validation.

VALIDATION_STATIC_GENERATION=true
VALIDATION_AUTO_GENERATE_MISSING=true
VALIDATION_FILE_WATCHING=false
VALIDATION_WATCH_INTERVAL=2
VALIDATION_SERVER_CACHE_TTL=300
VALIDATION_CLIENT_CACHE_TTL=3600
VALIDATION_ENABLE_VERSIONING=true
VALIDATION_PRELOAD_RULES=true
VALIDATION_LAZY_LOAD_THRESHOLD=5
VALIDATION_BUTTON_STATE_MANAGEMENT=true
VALIDATION_RACE_CONDITION_PROTECTION=true
VALIDATION_AUTO_DISCOVER_MODULES=true
VALIDATION_ENABLE_AJAX_FALLBACK=true
VALIDATION_FALLBACK_TIMEOUT=5000
VALIDATION_RETRY_ATTEMPTS=2
VALIDATION_LOG_FALLBACKS=false
VALIDATION_AUTO_GENERATE_ON_BUILD=true
VALIDATION_VERIFY_FILES_ON_BUILD=true
VALIDATION_FAIL_BUILD_ON_ERROR=false
VALIDATION_DEBUG_MODE=false
VALIDATION_LOG_PERFORMANCE=false
VALIDATION_SHOW_TIMESTAMPS=true
VALIDATION_VALIDATE_JSON=true

# =============================================================================
# SETUP NOTES
# =============================================================================
# INITIAL SETUP (first time on this machine):
# 1. cp .env.example .env
# 2. php artisan key:generate
# 3. Configure DB_* and MAIL_* variables above.
# 4. php artisan migrate --seed
# 5. npm install && npm run build
#
# PRODUCTION DEPLOYMENT:
# - Set APP_ENV=production and APP_DEBUG=false
# - Set SESSION_SECURE_COOKIE=true (requires HTTPS)
# - Set LOG_LEVEL=error and DATATABLES_ERROR=log
# - Use strong database passwords
# - Configure proper SMTP mail settings
# - Set up Redis for better cache/session/queue performance
#
# SECURITY:
# - Never commit .env to version control
# - Rotate sensitive credentials periodically
# - Monitor logs for suspicious activity
# =============================================================================
